# === XHAKINHA CLIPS AI — copie para .env (scripts/setup.py faz isso e gera o SECRET_KEY) ===
# NUNCA publique o .env no GitHub (ele está no .gitignore e no .dockerignore).
SECRET_KEY=
TIMEZONE=America/Sao_Paulo
DATA_DIR=/data
# Domínio https do seu painel (ex.: https://xhakinha.duckdns.org). Obrigatório p/ Instagram e login do TikTok.
PUBLIC_BASE_URL=
DOMAIN=
MAX_WORKERS=4
MIN_FREE_GB=5
# --- APIs (deixe vazio o que não for usar) ---
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=9000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# --- IA local opcional (descrições melhores): http://ollama:11434 ---
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
# --- Instagram: se o token foi gerado pelo fluxo "Instagram API com login do Instagram", use:
# GRAPH_BASE=https://graph.instagram.com/v21.0
# (padrão: https://graph.facebook.com/v21.0, para token do Facebook Login)
GRAPH_BASE=

# --- Backblaze B2 (API S3 compatível; bucket privado) ---
XH_STORAGE_BACKEND=b2
B2_REGION=
B2_ENDPOINT_URL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
XH_B2_MAX_GB=8
